rules_version = '2';

// Previously these rules were `allow read, write: if request.auth != null;`
// on /{document=**} — meaning ANY signed-in user could read or delete ANY
// other user's liked tracks and playlists. These rules lock client access
// down to data the requester owns. Anything not matched below is denied by
// default.
//
// Note: the Express backend uses the Firebase Admin SDK, which bypasses
// these rules entirely — so server-managed data (users/{uid}/engagement,
// public share-link reads via /api/shared/:id) needs no client rule.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own subtree (likedTracks, engagement, ...): owner only.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Playlists are created/edited directly from the client (usePlaylists).
    // Reads and mutations require ownership; creates must stamp the caller's
    // own uid as ownerId so nobody can create a playlist "as" someone else.
    // Public share links are served by the backend via the Admin SDK, so no
    // public read rule is needed here.
    match /playlists/{playlistId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;
    }
  }
}
